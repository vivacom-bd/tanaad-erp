APP_NAME=Tanaad
APP_ENV=local
APP_TIMEZONE=UTC
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Reverse proxies to trust for X-Forwarded-For/Proto (comma-separated IPs/CIDRs or *). Empty locally: none.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3340
DB_DATABASE=tanaad
DB_USERNAME=tanaad
DB_PASSWORD=tanaad

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6390

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://127.0.0.1:9000
MEDIA_BUCKET=tanaad-media
HR_BUCKET=tanaad-hr
# s3 (MinIO/S3) or local (storage/app/media|hr; no signed URLs, GET /media/{hash} streams). Testing defaults to local.
MEDIA_DISK=s3

VITE_APP_NAME="${APP_NAME}"

# Error reporting (inert until sentry/sentry-laravel is installed and a DSN is set)
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=

# Ledger checksum key (defaults to APP_KEY). Set once; keep with backups.
TANAAD_LEDGER_KEY=

# Rate limits (requests/minute) and role-based token lifetimes (minutes); see config/tanaad.php
TANAAD_RL_API=1200
TANAAD_RL_INGEST=120
TANAAD_TTL_CASHIER=480
TANAAD_TTL_GATE=480
TANAAD_DEVICE_STALE_MINUTES=15
