# Copy to infra/staging/api.env (gitignored). Laravel environment for the php-fpm, queue and scheduler containers.
APP_NAME=Tanaad
APP_ENV=staging
APP_KEY=CHANGE_ME_run_php_artisan_key_generate_--show
APP_DEBUG=false
APP_URL=https://staging.CHANGE_ME.example
# Behind Caddy: only Caddy can reach nginx (no published port), so trust the forwarded client IP/scheme it sets.
# Narrow to the compose network subnet (docker network inspect tanaad-staging_default) if you prefer.
TRUSTED_PROXIES=*
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tanaad_staging
DB_USERNAME=tanaad
DB_PASSWORD=CHANGE_ME

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_CONNECTION=redis
CACHE_STORE=redis

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME_LONG
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=tanaad-media
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

TANAAD_LEDGER_KEY=CHANGE_ME_set_once_keep_with_backups
SENTRY_LARAVEL_DSN=
