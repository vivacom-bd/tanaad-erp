# Copy to infra/devserver/api.env (gitignored). Laravel environment for the api, queue and scheduler containers.
APP_NAME=Tanaad
APP_ENV=staging
APP_KEY=CHANGE_ME
APP_DEBUG=false
APP_URL=http://CHANGE_ME_HOST:8083
LOG_CHANNEL=stderr
LOG_LEVEL=info
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tanaad
DB_USERNAME=tanaad
DB_PASSWORD=CHANGE_ME
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=array
# The web app signs in with bearer tokens, never cookie sessions: no host is "stateful" (otherwise a browser request from the app's own
# origin is CSRF-checked and answered 419).
SANCTUM_STATEFUL_DOMAINS=
# Media on the container disk (no MinIO on the dev host). Keep the storage volume.
MEDIA_DISK=local
TANAAD_LEDGER_KEY=CHANGE_ME
